{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vexil Search",
  "version": "0.2.0",
  "identifier": "com.vexil.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vexil Search",
        "width": 1024,
        "height": 768,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "center": true,
        "resizable": true,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0REM3NEM0OUY1RDdDRDIKUldUU2ZGMmZ4SFRjcENjazVuUFFWV2RsMUhZK3BLMDNmWk42QzdyazJEZFNpSytRUDlvOXdRTmwK",
      "endpoints": [
        "https://github.com/priyaranjan-sahu/vexil-search/releases/latest/download/latest.json"
      ]
    }
  }
}
